{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DagomApp",
  "version": "../package.json",
  "identifier": "fr.dagoma.dagomapp",
  "build": {
    "beforeDevCommand": "cargo run --quiet -p dagomapp-frontend -- dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo run --quiet -p dagomapp-frontend -- build",
    "frontendDist": "../target/frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "dmg"
    ],
    "publisher": "Dagoma",
    "homepage": "https://www.dagoma.fr",
    "category": "Utility",
    "shortDescription": "Set up Dagoma 3D printers",
    "longDescription": "DagomApp sets up Dagoma 3D printers over USB: printer detection, Z-offset calibration, PID tuning, factory reset and firmware flashing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libudev1"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-dagomapp.rules": "linux/70-dagomapp.rules"
        },
        "postInstallScript": "linux/reload-udev.sh",
        "postRemoveScript": "linux/reload-udev.sh"
      },
      "rpm": {
        "depends": [
          "libudev.so.1()(64bit)"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-dagomapp.rules": "linux/70-dagomapp.rules"
        },
        "postInstallScript": "linux/reload-udev.sh",
        "postRemoveScript": "linux/reload-udev.sh"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French"
        ]
      }
    }
  }
}
